PANEL_MODE=api
# Endereço visto pelo servidor Next.js; não é o IP do celular.
API_URL=http://127.0.0.1:3001
STORE_SLUG=bonamassa
# npm run setup gera uma chave exclusiva em .env.local. Não envie a chave ao Git.
SESSION_SECRET=
# false somente para HTTP na rede de desenvolvimento. HTTPS em produção: true.
COOKIE_SECURE=false
