# Modelo sem credenciais; não use valores de exemplo como configuração real.
NODE_ENV=production
APP_ENV=production
PANEL_MODE=api
API_URL=https://api.seu-dominio.example
PANEL_ORIGIN=https://painel.seu-dominio.example
STORE_SLUG=bonamassa
COOKIE_SECURE=true
# Gere 32 bytes aleatórios (64 caracteres hexadecimais). Nunca faça commit do valor.
SESSION_SECRET=
